{
  "name": "postal",
  "version": "1.0.0",
  "private": true,
  "description": "Postal — a self-hosted SMTP mail transfer agent with a network-telemetry dashboard.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace @postal/server",
    "dev:web": "npm run dev --workspace @postal/web",
    "build": "npm run build --workspace @postal/shared && npm run build --workspaces --if-present",
    "start": "npm run start --workspace @postal/server",
    "test": "npm run test --workspace @postal/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm run seed --workspace @postal/server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v"
  },
  "overrides": {
    "@fastify/static": "^10.1.3"
  }
}
