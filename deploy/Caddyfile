# Caddy obtains and renews Let's Encrypt certificates on its own, provided the
# domain's A record already points at this host. No certbot, no cron, no renewal
# script to forget about.

{$API_DOMAIN} {
	encode zstd gzip

	# The API and the OpenAPI docs.
	reverse_proxy server:4000

	header {
		# The API is consumed by fetch() from the web origin, never framed.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Optional: the Mailpit UI, so a visitor can read the mail the demo delivered.
#
# A Caddyfile has no conditionals, and an empty site address makes the whole
# config invalid ("server block without any key"). So when MAIL_UI_DOMAIN is not
# set this falls back to a .localhost name, which Caddy serves with its internal
# CA rather than requesting a public certificate — the block stays valid and the
# UI simply is not reachable from the internet.
{$MAIL_UI_DOMAIN:mailpit.localhost} {
	reverse_proxy mailpit:8025
}
