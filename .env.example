# ---------------------------------------------------------------------------
# Postal — configuration
#
# Copy to `.env` and adjust. Every variable is validated at boot by
# apps/server/src/config/env.ts; the process refuses to start on a bad value
# rather than failing later inside a request.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP API --------------------------------------------------------------
HOST=0.0.0.0
PORT=4000
# Origins allowed to make credentialed cross-site requests (comma-separated).
CORS_ORIGINS=http://localhost:3000

# --- Persistence -----------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/postal
# Optional. Unset it and the delivery queue falls back to an in-process driver
# that works but does not survive a restart.
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Must be true in any deployment served over HTTPS.
COOKIE_SECURE=false

# --- Mail ------------------------------------------------------------------
# The domain this MTA is authoritative for. Inbound mail for any other domain
# is refused, which is what stops the server being an open relay.
MAIL_DOMAIN=postal.local
SMTP_HOSTNAME=mx.postal.local
SMTP_INGRESS_PORT=2525
SMTP_INGRESS_ENABLED=true
SMTP_MAX_MESSAGE_BYTES=26214400

# Smart host. With this set, every outbound message is relayed here instead of
# going direct to the recipient's MX — which is how you run the whole project
# offline against Mailpit. Comment it out for real direct-to-MX delivery.
SMTP_RELAY_HOST=localhost
SMTP_RELAY_PORT=1025
# SMTP_RELAY_USER=
# SMTP_RELAY_PASS=

# disabled | opportunistic | require
SMTP_TLS_POLICY=opportunistic
# Set false only for a local relay with a self-signed certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- Delivery queue --------------------------------------------------------
DELIVERY_CONCURRENCY=4
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=15000
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_COMMAND_TIMEOUT_MS=30000

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10

# --- Web client ------------------------------------------------------------
# Where the Next.js dev server proxies /api to.
API_PROXY_TARGET=http://localhost:4000
