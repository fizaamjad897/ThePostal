# ---------------------------------------------------------------------------
# Production configuration. Copy to `.env.production` on the server and fill in.
#
# Run compose with --env-file so these values reach BOTH the container and
# compose's own variable interpolation:
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# `.env.production` is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# --- Domains (used by Caddy for automatic TLS) -----------------------------
# An A record for each must already point at this server's public IP.
API_DOMAIN=postal-api.yourdomain.com
# Optional. Leave blank to keep the mail sink UI off the public internet.
MAIL_UI_DOMAIN=postal-mail.yourdomain.com

# Credentials for the Mailpit UI, as `user:password`. Pick any password; it
# guards a demo mail sink, not anything sensitive. Mailpit also accepts a bcrypt
# hash here if you would rather not store it in plain text.
MAILPIT_UI_AUTH=demo:choose-a-password

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000

# The web origin allowed to call this API with credentials.
CORS_ORIGINS=https://your-app.vercel.app

# --- Managed data stores ---------------------------------------------------
# MongoDB Atlas M0 (free, permanent). Allow this server's IP in Atlas Network
# Access, or 0.0.0.0/0 if the box has no static IP.
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/postal?retryWrites=true&w=majority

# Upstash Redis (free tier). Omit entirely to fall back to the in-process
# queue — it works, but loses queued deliveries on restart.
REDIS_URL=rediss://default:password@region.upstash.io:6379

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE-ME-at-least-32-characters-of-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Required: the site is served over HTTPS.
COOKIE_SECURE=true

# --- Mail ------------------------------------------------------------------
MAIL_DOMAIN=postal.local
SMTP_HOSTNAME=mx.postal.local
SMTP_INGRESS_ENABLED=true
SMTP_INGRESS_PORT=2525
SMTP_MAX_MESSAGE_BYTES=26214400

# Relay into the local Mailpit sink — safe for a demo, delivers to nobody real.
# To send actual mail, point this at a provider on port 587 and set user/pass:
#   SMTP_RELAY_HOST=smtp.resend.com
#   SMTP_RELAY_PORT=587
#   SMTP_RELAY_USER=resend
#   SMTP_RELAY_PASS=re_xxxxxxxx
#   SMTP_TLS_POLICY=require
SMTP_RELAY_HOST=mailpit
SMTP_RELAY_PORT=1025
SMTP_TLS_POLICY=disabled
SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- Delivery & limits -----------------------------------------------------
DELIVERY_CONCURRENCY=4
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=15000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
